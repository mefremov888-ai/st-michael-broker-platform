generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ───────────────────────────────────────────

enum UserRole {
  BROKER
  MANAGER
  ADMIN
}

enum UserStatus {
  ACTIVE
  BLOCKED
  PENDING
}

enum CommissionLevel {
  START
  BASIC
  STRONG
  PREMIUM
  ELITE
  CHAMPION
  LEGEND
}

// Режим расчёта комиссии (политика для проекта в заданный период).
// PROGRESSIVE — традиционная шкала по м² (накопительно).
// FLAT — фиксированный процент для всех сделок (например 4% по Зорге 9 с 07.05.2026).
enum CommissionMode {
  PROGRESSIVE
  FLAT
}

enum Project {
  ZORGE9
  SILVER_BOR
  TOLBUKHINA // 2026-09-07: Толбухина — отдельный ЖК (решение владельца)
  UNKNOWN    // 2026-09-07: «Не указан» — КЦ до перехода в воронку ЖК, старый кабинет без проекта
}

enum UniquenessStatus {
  CONDITIONALLY_UNIQUE
  REJECTED
  UNDER_REVIEW // Спорная ситуация — ручное решение менеджера
  EXPIRED
}

// Этапы воронки брокеров в amoCRM
enum BrokerFunnelStage {
  NEW_BROKER
  BROKER_TOUR
  FIXATION
  MEETING
  DEAL
}

// Источник появления брокера
enum BrokerSource {
  CRM_MANUAL // Внесён менеджером вручную
  BROKER_CABINET // Зарегистрировался через кабинет
  PHONE_CALL // Позвонил на линию
  CLOSED_AS_BROKER // Закрыт как брокер (с причиной)
  // 2026-05-26: заявки с лендинга → попадают в очередь КЦ
  LANDING_BROKER_TOUR // Записался на брокер-тур
  LANDING_FORM // Оставил контакт через форму на лендинге
}

enum FixationStatus {
  NOT_FIXED
  FIXED
  EXPIRED
  ANNULLED
}

enum ClientStatus {
  NEW
  BOOKED
  DEAL
  CANCELLED
}

enum ContractType {
  DDU
  DKP
  PDKP
}

enum DealStatus {
  PENDING
  SIGNED
  PAID
  COMMISSION_PAID
  CANCELLED
}

enum LotStatus {
  AVAILABLE
  BOOKED
  SOLD
}

enum CallDirection {
  OUTBOUND
  INBOUND
}

enum CallStatus {
  // 2026-06-02: статус «звонок инициирован, ещё не завершён» —
  // используется брокерским callback'ом до прихода webhook от Mango.
  INITIATED
  COMPLETED
  NO_ANSWER
  BUSY
  UNAVAILABLE
  FAILED
}

enum CallResult {
  INTERESTED
  NOT_INTERESTED
  CALLBACK
  MEETING_SCHEDULED
}

enum Sentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
}

enum MeetingType {
  OFFICE_VISIT
  ONLINE
  BROKER_TOUR
}

// 2026-07-22: разделение менеджеров КЦ на штатных (Empire Estate) и
// аутсорс-операторов. Только для role=MANAGER; у остальных null.
enum KcTeam {
  STAFF
  OUTSOURCE
}

enum MeetingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum NotificationChannel {
  SMS
  WHATSAPP
  TELEGRAM
  EMAIL
  PUSH
}

enum NotificationStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
}

// База брокеров для КЦ (TZ v3 §2.2). Рабочие статусы холодного обзвона.
enum BrokerCategory {
  COLD // НДЗ (без 2x), новые из импорта — звонить регулярно
  WARM // Проинформирован, Только отправить инфо, Уже был
  HOT // Запись на БТ, В работе
  CONVERTED // Есть встреча/сделка — вне обзвонной воронки
  ON_BOT_REVIEW // 2 НДЗ, Отказ от коммуникации — «на проверке у бота»
  BLACKLIST // НЕ брокер, Некорректный номер — удалять через 6 мес
}

enum BrokerSpecialization {
  COMM
  RESIDENTIAL
  BOTH
}

// Результат холодного звонка оператора КЦ (TZ v3). Отличается от CallResult — тот про факт телефонии (Mango).
enum BrokerCallResult {
  NDZ
  DOUBLE_NDZ
  INFORMED
  ALREADY_KNOWS
  WRONG_NUMBER
  REFUSED_COMMUNICATION
  NOT_A_BROKER
  SCHEDULED_TOUR
  ONLY_SEND_INFO
  IN_PROGRESS
  REFUSED_TOUR
  HUNG_UP
  NOT_RELEVANT
  NOT_BROKER_ANYMORE
  ASKED_NOT_TO_CALL
  NEGATIVE
}

// ─── Loyalty base bounded context ─────────────────────────────────────
// ANNA is stored only in loyalty_* tables. OUR is a read-only projection
// over the existing Broker/Agency models and never receives imported rows.
enum LoyaltyBaseKind {
  ANNA
  OUR
}

enum LoyaltyEntityType {
  BROKER
  AGENCY
}

enum LoyaltySnapshotStatus {
  STAGED
  PUBLISHED
  SUPERSEDED
  REJECTED
}

enum LoyaltyContactPointType {
  PHONE
  EMAIL
  TELEGRAM
  WHATSAPP
  OTHER
}

enum LoyaltyExternalSystem {
  AMOCRM
  BROKER_CABINET
  GOOGLE_SHEETS
  ANNA_FILE
  MANUAL
}

enum LoyaltyExternalEntityType {
  CONTACT
  COMPANY
  LEAD
  OTHER
}

enum LoyaltyActivityType {
  FIXATION
  MEETING
  DEAL
  BROKER_TOUR
  CALL
}

enum LoyaltyActivityVerdict {
  INCLUDED
  EXCLUDED
  UNKNOWN
}

// Aggregate-only facts copied from a source such as Anna's curated legacy
// workbook. They are deliberately not LoyaltyActivity rows: the source does
// not contain one independently identifiable event per count.
enum LoyaltyAggregateQuality {
  SOURCE_REPORTED
  PARTIAL
  UNVERIFIED
}

enum LoyaltyAggregateExactness {
  EXACT
  APPROXIMATE
  UNKNOWN
}

enum LoyaltyAggregatePeriodKind {
  LIFETIME
  DATE_RANGE
  MONTHLY_BREAKDOWN
  UNKNOWN
}

enum LoyaltyLinkStatus {
  PROPOSED
  CONFIRMED
  REJECTED
  REVOKED
}

enum LoyaltyReconciliationStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum LoyaltyReconciliationDecision {
  LINK
  KEEP_SEPARATE
  REJECT_MATCH
  SUPPLEMENT
  ARCHIVE
  UNLINK
}

enum LoyaltyChangeAction {
  UPDATE
  ARCHIVE
  RESTORE
}

enum LoyaltyCampaignStatus {
  DRAFT
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum LoyaltyAssignmentStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum LoyaltyCallResult {
  INFORMED
  DO_NOT_CALL
  NOT_INTERESTED
  NO_ANSWER
  SEND_INFORMATION
  BROKER_TOUR_BOOKED
  BROKER_TOUR_DECLINED
  INVALID_PHONE
  NOT_A_BROKER
  COOPERATION_DECLINED
  BROKER_TOUR_SCHEDULED
  CALLBACK
  AGREEMENTS_EXIST
  COOPERATION_AGREED
}

enum LoyaltyTaskStatus {
  OPEN
  COMPLETED
  CANCELLED
}

enum LoyaltyEngagementType {
  GIFT
  AWARD
  PRIVATE_EVENT
  INDIVIDUAL_TERMS
  PERSONAL_DISCOUNT
  PERSONAL_COMMISSION
}

enum LoyaltyPermission {
  READ_ALL
  READ_OWN_QUEUE
  CALL_EXECUTE
  CALL_ASSIGN
  ENTITY_EDIT
  REFERENCE_MANAGE
  EXPORT
  IMPORT
  RECONCILE
  AUDIT_READ
  ANALYTICS_SYNC
}

enum LoyaltyExportStatus {
  PENDING
  READY
  FAILED
  EXPIRED
}

enum LoyaltySyncSource {
  GOOGLE_SHEETS
  AMOCRM
}

enum LoyaltySyncStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

// ─── MODELS ──────────────────────────────────────────

model Agency {
  id                   String                   @id @default(uuid())
  name                 String
  legalName            String?                  @map("legal_name")
  inn                  String                   @unique // ОБЯЗАТЕЛЬНОЕ — ключ дедупликации и связи с кабинетом
  phone                String?
  email                String?
  address              String?
  legalAddress         String?                  @map("legal_address")
  bankName             String?                  @map("bank_name")
  bankBik              String?                  @map("bank_bik")
  bankAccount          String?                  @map("bank_account")
  correspondentAccount String?                  @map("correspondent_account")
  totalSqmSold         Decimal                  @default(0) @map("total_sqm_sold") @db.Decimal(10, 2)
  commissionLevel      CommissionLevel          @default(START) @map("commission_level")
  quarterlyBonusStreak Int                      @default(0) @map("quarterly_bonus_streak")
  brokerAgencies       BrokerAgency[]
  deals                Deal[]
  loyaltyAssignments   LoyaltyCallAssignment[]  @relation("LoyaltyAssignmentOurAgency")
  loyaltyTasks         LoyaltyTask[]            @relation("LoyaltyTaskOurAgency")
  loyaltyEvents        LoyaltyEngagementEvent[] @relation("LoyaltyEventOurAgency")
  createdAt            DateTime                 @default(now()) @map("created_at")
  updatedAt            DateTime                 @updatedAt @map("updated_at")

  @@map("agencies")
}

// M2M: Брокер ↔ Компании (неограниченное кол-во, не удаляются)
model BrokerAgency {
  id        String   @id @default(uuid())
  brokerId  String   @map("broker_id")
  broker    Broker   @relation(fields: [brokerId], references: [id])
  agencyId  String   @map("agency_id")
  agency    Agency   @relation(fields: [agencyId], references: [id])
  isPrimary Boolean  @default(false) @map("is_primary") // Основная компания
  joinedAt  DateTime @default(now()) @map("joined_at")

  @@unique([brokerId, agencyId]) // Без повторов
  @@map("broker_agencies")
}

model Broker {
  id                                String                       @id @default(uuid())
  amoContactId                      BigInt?                      @unique @map("amo_contact_id")
  fullName                          String                       @map("full_name")
  // 2026-09-07: «имя для работы» — то, что видит КЦ в «Нашей базе» (список
  // и карточка). Брокер в своём кабинете продолжает видеть fullName
  // (самоназвание), displayName в брокерские ответы НЕ отдаётся.
  // Источник заполнения: 'self' (здоровое fullName) | 'old_cabinet'
  // (ФИО из старого кабинета по телефону) | 'amo' (имя контакта amo) |
  // 'manual' (правка КЦ из карточки). Бэкфилл: scripts/backfill-display-names.js
  // — уже заполненный displayName никогда не перезаписывает.
  displayName                       String?                      @map("display_name")
  displayNameSource                 String?                      @map("display_name_source")
  phone                             String                       @unique
  email                             String?
  avatarUrl                         String?                      @map("avatar_url")
  birthDate                         DateTime?                    @map("birth_date") @db.Date
  passwordHash                      String?                      @map("password_hash")
  passwordResetToken                String?                      @unique @map("password_reset_token")
  passwordResetExpiresAt            DateTime?                    @map("password_reset_expires_at")
  role                              UserRole                     @default(BROKER)
  status                            UserStatus                   @default(PENDING)
  funnelStage                       BrokerFunnelStage            @default(NEW_BROKER) @map("funnel_stage")
  source                            BrokerSource? // Откуда пришёл брокер
  closureReason                     String?                      @map("closure_reason") // Причина закрытия (если закрыт)
  brokerAgencies                    BrokerAgency[] // M2M — список компаний (не удаляются)
  telegramChatId                    BigInt?                      @unique @map("telegram_chat_id")
  brokerTourVisited                 Boolean                      @default(false) @map("broker_tour_visited")
  brokerTourDate                    DateTime?                    @map("broker_tour_date")
  doNotCall                         Boolean                      @default(false) @map("do_not_call")
  bestCallTime                      String?                      @map("best_call_time")
  // 2026-06-09: внутренний номер сотрудника в Mango (для click-to-call:
  // Mango сначала набирает этот номер, оператор берёт трубку → соединение).
  mangoEmployeeNum                  String?                      @unique @map("mango_employee_num")
  // 2026-07-22: Штат (Empire Estate) / Аутсорс — только для role=MANAGER.
  // Backfill: scripts/backfill-kc-team.js (6 штатных по ФИО из
  // docs/call-center-team.md, остальные MANAGER → OUTSOURCE).
  kcTeam                            KcTeam?                      @map("kc_team")
  // ─── Поля для амо-карточки контакта (sync через brokerToAmoContactFields) ───
  position                          String? // Должность
  telegramUsername                  String?                      @map("telegram_username")
  telegramId                        String?                      @map("telegram_id") // Хранится как строка (могут быть длинные ID)
  whatsappUsername                  String?                      @map("whatsapp_username")
  presentationSent                  Boolean                      @default(false) @map("presentation_sent")
  // ─── База брокеров КЦ (TZ v3 §5) ───
  category                          BrokerCategory               @default(COLD)
  specialization                    BrokerSpecialization?
  region                            String? // MSK / SPB / OTHER
  // 2026-07-09: пометка «региональный» — КЦ в комментариях пишет что
  // брокер из региона (регекс парсит «регион», «региональ»). Хранится
  // как отдельный признак, не как значение specialization: региональный
  // брокер может параллельно быть коммерческим или жилым.
  isRegional                        Boolean                      @default(false) @map("is_regional")
  isCoordinator                     Boolean                      @default(false) @map("is_coordinator")
  coordinatorAgency                 String?                      @map("coordinator_agency")
  lastCallAt                        DateTime?                    @map("last_call_at")
  nextCallAt                        DateTime?                    @map("next_call_at")
  isInBase                          Boolean                      @default(false) @map("is_in_base")
  baseSource                        String?                      @map("base_source") // 'google_sheet' | 'amocrm' | 'manual'
  // 2026-06-03: распределение брокера на менеджера КЦ. Self-FK на Broker.id
  // где role=MANAGER. Руководитель КЦ батч-назначает, менеджер видит
  // дефолтным фильтром «только мои» в /admin/call-center.
  assignedManagerId                 String?                      @map("assigned_manager_id")
  assignedManager                   Broker?                      @relation("BrokerAssignedManager", fields: [assignedManagerId], references: [id])
  assignedBrokers                   Broker[]                     @relation("BrokerAssignedManager")
  assignedAt                        DateTime?                    @map("assigned_at")
  phones                            BrokerPhone[]
  callLogs                          CallLog[]
  clients                           Client[]
  responsibleForClients             Client[]                     @relation("ClientResponsibleBroker")
  deals                             Deal[]
  calls                             Call[]
  meetings                          Meeting[]
  notifications                     Notification[]
  pushSubscriptions                 PushSubscription[]
  notificationPrefs                 NotificationPreference[]
  offerAcceptances                  OfferAcceptance[]
  privacyAcceptances                PrivacyAcceptance[]
  favoriteLots                      FavoriteLot[]
  loyaltyCampaignsCreated           LoyaltyCallCampaign[]        @relation("LoyaltyCampaignCreator")
  loyaltyAssignmentsAsTarget        LoyaltyCallAssignment[]      @relation("LoyaltyAssignmentOurBroker")
  loyaltyAssignmentsAssignedTo      LoyaltyCallAssignment[]      @relation("LoyaltyAssignmentAssignee")
  loyaltyAssignmentsAssignedBy      LoyaltyCallAssignment[]      @relation("LoyaltyAssignmentAssigner")
  loyaltyCallAttempts               LoyaltyCallAttempt[]         @relation("LoyaltyCallAttemptOperator")
  loyaltyTasksAsTarget              LoyaltyTask[]                @relation("LoyaltyTaskOurBroker")
  loyaltyTasksAssignedTo            LoyaltyTask[]                @relation("LoyaltyTaskAssignee")
  loyaltyTasksCreated               LoyaltyTask[]                @relation("LoyaltyTaskCreator")
  loyaltyEventsAsTarget             LoyaltyEngagementEvent[]     @relation("LoyaltyEventOurBroker")
  loyaltyEventsCreated              LoyaltyEngagementEvent[]     @relation("LoyaltyEventCreator")
  loyaltyEventAttachmentsCreated    LoyaltyEventAttachment[]     @relation("LoyaltyEventAttachmentCreator")
  loyaltySavedViews                 LoyaltySavedView[]           @relation("LoyaltySavedViewOwner")
  loyaltyWorkflowAudits             LoyaltyWorkflowAudit[]       @relation("LoyaltyWorkflowAuditActor")
  loyaltyGrants                     LoyaltyUserGrant[]           @relation("LoyaltyGrantUser")
  loyaltyGrantsIssued               LoyaltyUserGrant[]           @relation("LoyaltyGrantIssuer")
  loyaltyExports                    LoyaltyExportJob[]           @relation("LoyaltyExportCreator")
  loyaltySyncRuns                   LoyaltySyncRun[]             @relation("LoyaltySyncRequestedBy")
  loyaltyManualEntitiesCreated      LoyaltyManualEntity[]        @relation("LoyaltyManualCreator")
  loyaltyContactOverridesCreated    LoyaltyContactOverride[]     @relation("LoyaltyContactOverrideCreator")
  loyaltyAgencyContactPeopleCreated LoyaltyAgencyContactPerson[] @relation("LoyaltyAgencyContactPersonCreator")
  createdAt                         DateTime                     @default(now()) @map("created_at")
  updatedAt                         DateTime                     @updatedAt @map("updated_at")
  // 2026-07-10: момент повторной активации аккаунта — ставится когда админ
  // переводит status из BLOCKED/CLOSED обратно в ACTIVE. Используется на
  // /admin/broker-applications, вкладка «Заходы».
  reactivatedAt                     DateTime?                    @map("reactivated_at")
  // 2026-07-17: ручное слияние дублей (/admin/broker-dedup). Карточка с
  // mergedIntoId — дубль, слитый в другую; из очередей и списков скрывается,
  // но НЕ удаляется (решение пользователя: ничего не удалять). Телефон
  // дубля при слиянии копируется в BrokerPhone основной карточки.
  mergedIntoId                      String?                      @map("merged_into_id")
  mergedInto                        Broker?                      @relation("BrokerMergedInto", fields: [mergedIntoId], references: [id])
  mergedBrokers                     Broker[]                     @relation("BrokerMergedInto")
  mergedAt                          DateTime?                    @map("merged_at")
  registryDeals                     RegistryDeal[]

  @@index([category])
  @@index([nextCallAt])
  @@index([assignedManagerId])
  @@map("brokers")
}

model Client {
  id                   String           @id @default(uuid())
  brokerId             String           @map("broker_id") // владелец кабинета (для координатора — координатор)
  broker               Broker           @relation(fields: [brokerId], references: [id])
  // 2026-06-19: для координаторов — реальный брокер, который ведёт клиента.
  // Nullable для обратной совместимости: если поле пустое, ответственный = brokerId
  // (как было раньше). У координаторов на новых фиксациях ОБЯЗАТЕЛЬНО.
  responsibleBrokerId  String?          @map("responsible_broker_id")
  responsibleBroker    Broker?          @relation("ClientResponsibleBroker", fields: [responsibleBrokerId], references: [id])
  amoLeadId            BigInt?          @map("amo_lead_id")
  fullName             String           @map("full_name")
  phone                String
  email                String?
  comment              String?
  project              Project          @default(ZORGE9)
  fixationAgencyId     String?          @map("fixation_agency_id") // Компания, от которой подана заявка
  uniquenessStatus     UniquenessStatus @default(CONDITIONALLY_UNIQUE) @map("uniqueness_status")
  uniquenessReason     String?          @map("uniqueness_reason") // Пояснение (напр. «переоткрыта сделка»)
  uniquenessExpiresAt  DateTime?        @map("uniqueness_expires_at")
  fixationStatus       FixationStatus   @default(NOT_FIXED) @map("fixation_status")
  fixationExpiresAt    DateTime?        @map("fixation_expires_at")
  inspectionActSigned  Boolean          @default(false) @map("inspection_act_signed")
  status               ClientStatus     @default(NEW)
  deals                Deal[]
  meetings             Meeting[]
  calls                Call[]
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")
  // amoCRM dates — для показа в кабинете вместо нашей sync-даты.
  amoCreatedAt         DateTime?        @map("amo_created_at")
  amoUpdatedAt         DateTime?        @map("amo_updated_at")
  // 2026-05-25: статус синка с amoCRM. Если amo упал во время фиксации,
  // клиент НЕ теряется (остаётся в БД), а сюда пишем FAILED и amoSyncError.
  // Менеджеры/координаторы видят список FAILED, scheduler ретраит.
  amoSyncStatus        AmoSyncStatus    @default(SYNCED) @map("amo_sync_status")
  amoSyncError         String?          @map("amo_sync_error")
  amoSyncAttempts      Int              @default(0) @map("amo_sync_attempts")
  amoSyncLastAttemptAt DateTime?        @map("amo_sync_last_attempt_at")

  // 2026-06-09: поля формы фиксации — раньше склеивались в comment строкой,
  // что мешало брокеру видеть структурированно. Теперь храним каждое поле
  // отдельно и показываем в карточке клиента.
  propertyType   String?  @map("property_type") // «Квартира» / «Апартаменты» / «Коммерция» и т.п.
  roomsCount     String?  @map("rooms_count") // «Студия» / «1» / «2» / ... / «Коммерческое помещение»
  amount         Decimal? @db.Decimal(14, 2) // бюджет покупки, руб.
  sqm            Decimal? @db.Decimal(10, 2) // метраж, м²
  clientRegion   String?  @map("client_region") // «Москва / СПб / другой»
  purchaseTiming String?  @map("purchase_timing") // «1-3 месяца» / «3-6» / «от 5» / «Не выяснил»
  readinessLevel String?  @map("readiness_level") // «Горячий» / «Тёплый» / «Холодный»

  @@index([phone])
  @@index([brokerId])
  @@index([amoSyncStatus])
  // 2026-09-08: один лид amo = одна запись у брокера (корень дублей синка,
  // PR 493); NULL amo_lead_id (ручные заявки) уникальностью не ограничен.
  @@unique([brokerId, amoLeadId])
  @@map("clients")
}

enum AmoSyncStatus {
  SYNCED
  PENDING
  FAILED
}

model Lot {
  id               String        @id @default(uuid())
  externalId       String?       @unique @map("external_id")
  number           String
  project          Project       @default(ZORGE9)
  building         String
  floor            Int
  rooms            String
  sqm              Decimal       @db.Decimal(10, 2)
  price            Decimal       @db.Decimal(14, 2)
  pricePerSqm      Decimal?      @map("price_per_sqm") @db.Decimal(10, 2)
  status           LotStatus     @default(AVAILABLE)
  propertyType     String?       @map("property_type")
  layoutUrl        String?       @map("layout_url")
  planImageUrl     String?       @map("plan_image_url")
  // Raw image URLs from the ProfitBase feed, in feed order (plan is always
  // first). Repopulated on every syncFromFeed() run.
  feedImageUrls    String[]      @default([]) @map("feed_image_urls")
  // Final gallery order for display: [plan, ...personal Yandex.Disk photos,
  // ...remaining feed photos]. Computed by YandexDiskPhotosService after
  // each feed sync — see docs/yandex-disk-photos-feed.md.
  photos           String[]      @default([]) @map("photos")
  description      String?
  floorsTotal      Int?          @map("floors_total")
  buildingSection  String?       @map("building_section")
  windowView       String?       @map("window_view")
  builtYear        Int?          @map("built_year")
  readyQuarter     Int?          @map("ready_quarter")
  buildingState    String?       @map("building_state")
  hasBalcony       Boolean       @default(false) @map("has_balcony")
  hasTerrace       Boolean       @default(false) @map("has_terrace")
  isPenthouse      Boolean       @default(false) @map("is_penthouse")
  isCornerLayout   Boolean       @default(false) @map("is_corner_layout")
  hasStorage       Boolean       @default(false) @map("has_storage")
  twoBathrooms     Boolean       @default(false) @map("two_bathrooms")
  hasMasterBedroom Boolean       @default(false) @map("has_master_bedroom")
  isUrbanVilla     Boolean       @default(false) @map("is_urban_villa")
  isViewLot        Boolean       @default(false) @map("is_view_lot")
  isHighFlat       Boolean       @default(false) @map("is_high_flat") // ceilings 4.2+ м
  discountPrice    Decimal?      @map("discount_price") @db.Decimal(14, 2)
  discountPercent  Decimal?      @map("discount_percent") @db.Decimal(5, 2)
  discountName     String?       @map("discount_name")
  deals            Deal[]
  favoritedBy      FavoriteLot[]
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  @@index([project, status])
  @@map("lots")
}

model Deal {
  id               String        @id @default(uuid())
  clientId         String        @map("client_id")
  client           Client        @relation(fields: [clientId], references: [id])
  brokerId         String        @map("broker_id")
  broker           Broker        @relation(fields: [brokerId], references: [id])
  agencyId         String?       @map("agency_id") // Компания, от которой сделка (привязка на ДВОУ)
  agency           Agency?       @relation(fields: [agencyId], references: [id])
  lotId            String?       @map("lot_id")
  lot              Lot?          @relation(fields: [lotId], references: [id])
  amoDealId        BigInt?       @map("amo_deal_id")
  // ID родительской карточки в amoCRM (custom field "cc_id_parent" 839249).
  // На одну реальную продажу в amoCRM может быть 2-3 карточки в разных воронках,
  // связанные через это поле. Используется для дедупа: child→parent ссылка.
  amoParentDealId  BigInt?       @map("amo_parent_deal_id")
  project          Project       @default(ZORGE9)
  contractType     ContractType? @map("contract_type")
  amount           Decimal       @db.Decimal(14, 2)
  sqm              Decimal       @db.Decimal(10, 2)
  commissionRate   Decimal       @map("commission_rate") @db.Decimal(5, 2)
  commissionAmount Decimal       @map("commission_amount") @db.Decimal(14, 2)
  paymentReceived  Boolean       @default(false) @map("payment_received")
  paymentPercent   Decimal       @default(0) @map("payment_percent") @db.Decimal(5, 2)
  isInstallment    Boolean       @default(false) @map("is_installment")
  status           DealStatus    @default(PENDING)
  signedAt         DateTime?     @map("signed_at")
  paidAt           DateTime?     @map("paid_at")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  @@index([brokerId])
  @@index([clientId])
  @@index([agencyId])
  @@map("deals")
}

model Call {
  id            String        @id @default(uuid())
  brokerId      String        @map("broker_id")
  broker        Broker        @relation(fields: [brokerId], references: [id])
  // 2026-06-02: брокер→клиент звонки из кабинета через Mango. clientId
  // nullable, потому что есть исторические звонки КЦ→брокер без клиента.
  clientId      String?       @map("client_id")
  client        Client?       @relation(fields: [clientId], references: [id])
  mangoCallId   String?       @map("mango_call_id")
  // Official Mango /events/call ordering counter. Notifications are ordered
  // by seq, not by arrival time; nullable for historical and legacy events.
  mangoEventSeq BigInt?       @map("mango_event_seq")
  direction     CallDirection @default(OUTBOUND)
  status        CallStatus    @default(COMPLETED)
  result        CallResult?
  durationSec   Int?          @map("duration_sec")
  transcript    String?
  sentiment     Sentiment?
  recordingUrl  String?       @map("recording_url")
  attemptNumber Int           @default(1) @map("attempt_number")
  cycleDay      Int           @default(1) @map("cycle_day")
  materialsSent Json?         @map("materials_sent")
  // 2026-06-02: время инициации звонка (брокер нажал «Позвонить»).
  // Отделяем от createdAt, который может смещаться при webhook-апдейте.
  initiatedAt   DateTime      @default(now()) @map("initiated_at")
  createdAt     DateTime      @default(now()) @map("created_at")

  @@index([brokerId, createdAt])
  @@index([clientId, createdAt])
  @@index([mangoCallId])
  @@map("calls")
}

// Дополнительные телефоны брокера (TZ v3 §2.3). Broker.phone остаётся primary.
// 2026-07-17: группа дублей ФИО, помеченная админом как «это разные люди»
// на /admin/broker-dedup — такая группа больше не показывается в списке.
model BrokerDedupDismissal {
  id          String   @id @default(uuid())
  nameKey     String   @unique @map("name_key") // lower(btrim(full_name))
  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("broker_dedup_dismissals")
}

model BrokerPhone {
  id        String   @id @default(uuid())
  brokerId  String   @map("broker_id")
  broker    Broker   @relation(fields: [brokerId], references: [id])
  phone     String   @unique
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([brokerId])
  @@map("broker_phones")
}

// Лог результата холодного звонка оператора КЦ (TZ v3 §5). Не путать с Call (телефония Mango).
model CallLog {
  id         String           @id @default(uuid())
  brokerId   String           @map("broker_id")
  broker     Broker           @relation(fields: [brokerId], references: [id])
  operatorId String?          @map("operator_id")
  campaign   String? // имя кампании-строкой; ссылка на Campaign на будущее
  result     BrokerCallResult
  comment    String?
  nextCallAt DateTime?        @map("next_call_at")
  duration   Int? // секунды, если оператор зафиксировал
  createdAt  DateTime         @default(now()) @map("created_at")

  @@index([brokerId, createdAt])
  @@index([operatorId, createdAt])
  @@map("call_logs")
}

// Кампания обзвона (TZ v3 §2.5): «Зорге 9», «Серебряный Бор», «Новые условия» и т.д.
model Campaign {
  id          String    @id @default(uuid())
  name        String
  description String?
  createdById String    @map("created_by_id")
  startAt     DateTime? @map("start_at")
  endAt       DateTime? @map("end_at")
  isActive    Boolean   @default(true) @map("is_active")
  filters     Json // фильтры таргетинга (category/specialization/region/...)
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([isActive])
  @@map("campaigns")
}

model Meeting {
  id          String        @id @default(uuid())
  // 2026-09-07: clientId nullable — встречи КЦ «с брокером» (воронка 7600542,
  // статус 142) и брокер-туры не имеют клиента. onDelete: Restrict задан явно:
  // до этого поле было required (дефолт Prisma = Restrict), политика удаления
  // клиентов не меняется — меняется только NOT NULL.
  clientId    String?       @map("client_id")
  client      Client?       @relation(fields: [clientId], references: [id], onDelete: Restrict)
  brokerId    String        @map("broker_id")
  broker      Broker        @relation(fields: [brokerId], references: [id])
  managerId   String?       @map("manager_id")
  slotId      String?       @map("slot_id")
  slot        MeetingSlot?  @relation(fields: [slotId], references: [id])
  type        MeetingType
  date        DateTime
  comment     String?
  status      MeetingStatus @default(PENDING)
  actSigned   Boolean       @default(false) @map("act_signed")
  reminded24h Boolean       @default(false) @map("reminded_24h")
  reminded1h  Boolean       @default(false) @map("reminded_1h")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@index([brokerId, date])
  @@index([date, status])
  @@map("meetings")
}

// Доступные слоты времени, настраиваемые менеджером.
// Брокер выбирает слот при создании встречи; capacity = сколько встреч можно забронировать.
model MeetingSlot {
  id          String       @id @default(uuid())
  startsAt    DateTime     @map("starts_at")
  durationMin Int          @default(60) @map("duration_min")
  capacity    Int          @default(1)
  type        MeetingType? // null = любой тип
  isActive    Boolean      @default(true) @map("is_active")
  meetings    Meeting[]
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@index([startsAt, isActive])
  @@map("meeting_slots")
}

model Document {
  id          String   @id @default(uuid())
  name        String
  description String?
  type        String // mime type or extension label (PDF, DOCX, MP4, URL...)
  category    String // cooperation | analytics | marketing | materials
  subcategory String? // optional sub-grouping label
  project     Project?
  fileUrl     String   @map("file_url") // local: /files/<cat>/<uuid>.ext  |  external URL
  fileSize    Int?     @map("file_size")
  isPublic    Boolean  @default(true) @map("is_public")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([category, isPublic, sortOrder])
  @@map("documents")
}

model Notification {
  id        String              @id @default(uuid())
  brokerId  String              @map("broker_id")
  broker    Broker              @relation(fields: [brokerId], references: [id])
  channel   NotificationChannel
  subject   String?
  body      String
  status    NotificationStatus  @default(PENDING)
  sentAt    DateTime?           @map("sent_at")
  createdAt DateTime            @default(now()) @map("created_at")

  @@index([brokerId, createdAt])
  @@map("notifications")
}

model PushSubscription {
  id        String   @id @default(uuid())
  brokerId  String   @map("broker_id")
  broker    Broker   @relation(fields: [brokerId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String // public key (base64url)
  auth      String // auth secret (base64url)
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([brokerId])
  @@map("push_subscriptions")
}

// Per-broker per-event-type per-channel toggle.
// Missing row = enabled by default (opt-out model).
model NotificationPreference {
  id        String              @id @default(uuid())
  brokerId  String              @map("broker_id")
  broker    Broker              @relation(fields: [brokerId], references: [id], onDelete: Cascade)
  eventType String              @map("event_type") // NEW_LOTS, PROMOTIONS, COMMISSION_ACCRUED, COMMISSION_PAID, FIXATION_EXPIRY, MEETING_REMINDER, BOOKING_CONFIRMED, DEAL_STATUS, ANNOUNCEMENTS
  channel   NotificationChannel
  enabled   Boolean             @default(true)
  updatedAt DateTime            @updatedAt @map("updated_at")

  @@unique([brokerId, eventType, channel])
  @@index([brokerId])
  @@map("notification_preferences")
}

// Manual broadcast campaigns sent by admins.
model Mailing {
  id              String   @id @default(uuid())
  createdById     String   @map("created_by_id")
  subject         String?
  body            String
  channels        Json // ["EMAIL","PUSH","TELEGRAM","SMS"]
  filters         Json // segmentation criteria — see service
  recipientsCount Int      @default(0) @map("recipients_count")
  sentAt          DateTime @default(now()) @map("sent_at")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([sentAt])
  @@map("mailings")
}

// Acceptance record of the public offer (договор оферты) by a broker.
// Stored per offer version so admin can publish a new version without invalidating prior acceptances.
// 2026-06-15 (правки Ксении KB5 #3): «избранное» лотов для брокера.
// Раньше хранили в localStorage — терялось при очистке кэша и не
// синхронизировалось между устройствами. Теперь в БД, одна запись на
// (broker, lot). Каскад: удалили лот → ушёл из избранного автоматом.
model FavoriteLot {
  id        String   @id @default(uuid())
  brokerId  String   @map("broker_id")
  broker    Broker   @relation(fields: [brokerId], references: [id], onDelete: Cascade)
  lotId     String   @map("lot_id")
  lot       Lot      @relation(fields: [lotId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([brokerId, lotId])
  @@index([brokerId])
  @@map("favorite_lots")
}

model OfferAcceptance {
  id           String   @id @default(uuid())
  brokerId     String   @map("broker_id")
  broker       Broker   @relation(fields: [brokerId], references: [id], onDelete: Cascade)
  offerVersion String   @map("offer_version")
  acceptedAt   DateTime @default(now()) @map("accepted_at")
  ip           String?
  userAgent    String?  @map("user_agent")
  signedPdfUrl String?  @map("signed_pdf_url")

  @@unique([brokerId, offerVersion])
  @@index([brokerId])
  @@map("offer_acceptances")
}

// 2026-06-15 (правки Ксении KB5 #5): согласие на обработку персональных
// данных по 152-ФЗ. Отдельный документ от оферты — закон требует явное
// согласие на обработку ПД, оно не покрывается акцептом оферты.
// Версионируем чтобы при изменении текста требовать переподтверждения.
model PrivacyAcceptance {
  id             String   @id @default(uuid())
  brokerId       String   @map("broker_id")
  broker         Broker   @relation(fields: [brokerId], references: [id], onDelete: Cascade)
  privacyVersion String   @map("privacy_version")
  acceptedAt     DateTime @default(now()) @map("accepted_at")
  ip             String?
  userAgent      String?  @map("user_agent")

  @@unique([brokerId, privacyVersion])
  @@index([brokerId])
  @@map("privacy_acceptances")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  payload   Json?
  ip        String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([entity, entityId])
  @@index([userId, createdAt])
  @@map("audit_logs")
}

// ─── Loyalty base bounded context ─────────────────────────────────────
// The published snapshot pointer is the only switch used by ANNA reads.
// Staging therefore cannot leak partially imported records to the UI.
model LoyaltyDataset {
  id                  String                       @id @default(uuid())
  code                String                       @unique
  name                String
  base                LoyaltyBaseKind              @default(ANNA)
  activeSnapshotId    String?                      @unique @map("active_snapshot_id")
  activeSnapshot      LoyaltySnapshot?             @relation("LoyaltyActiveSnapshot", fields: [activeSnapshotId], references: [id], onDelete: SetNull)
  snapshots           LoyaltySnapshot[]            @relation("LoyaltyDatasetSnapshots")
  persons             LoyaltyPerson[]
  organizations       LoyaltyOrganization[]
  reconciliationCases LoyaltyReconciliationCase[]
  publicationEvents   LoyaltyPublicationEvent[]
  manualEntities      LoyaltyManualEntity[]
  contactOverrides    LoyaltyContactOverride[]
  agencyContactPeople LoyaltyAgencyContactPerson[]
  archivedAt          DateTime?                    @map("archived_at")
  createdAt           DateTime                     @default(now()) @map("created_at")
  updatedAt           DateTime                     @updatedAt @map("updated_at")

  @@index([base, archivedAt])
  @@map("loyalty_datasets")
}

model LoyaltySnapshot {
  id                  String                      @id @default(uuid())
  datasetId           String                      @map("dataset_id")
  dataset             LoyaltyDataset              @relation("LoyaltyDatasetSnapshots", fields: [datasetId], references: [id], onDelete: Restrict)
  activeForDataset    LoyaltyDataset?             @relation("LoyaltyActiveSnapshot")
  status              LoyaltySnapshotStatus       @default(STAGED)
  sourceName          String                      @map("source_name")
  contentHash         String                      @map("content_hash")
  ruleVersion         String                      @map("rule_version")
  expectedRecords     Int?                        @map("expected_records")
  recordCount         Int                         @default(0) @map("record_count")
  brokerCount         Int                         @default(0) @map("broker_count")
  agencyCount         Int                         @default(0) @map("agency_count")
  activityCount       Int                         @default(0) @map("activity_count")
  errorCount          Int                         @default(0) @map("error_count")
  summary             Json?
  createdById         String?                     @map("created_by_id")
  publishedById       String?                     @map("published_by_id")
  publishedAt         DateTime?                   @map("published_at")
  createdAt           DateTime                    @default(now()) @map("created_at")
  sourceRecords       LoyaltySourceRecord[]
  activities          LoyaltyActivity[]
  reconciliationCases LoyaltyReconciliationCase[]
  publicationEvents   LoyaltyPublicationEvent[]   @relation("LoyaltyPublicationTarget")
  replacedByEvents    LoyaltyPublicationEvent[]   @relation("LoyaltyPublicationPrevious")
  callCampaigns       LoyaltyCallCampaign[]

  @@unique([datasetId, contentHash])
  @@unique([datasetId, id])
  @@index([datasetId, status, createdAt])
  @@map("loyalty_snapshots")
}

// Stable ANNA identity. Imported PII lives in snapshot-scoped SourceRecord;
// explicit manual overrides remain separate and never touch public.brokers.
model LoyaltyPerson {
  id                  String                          @id @default(uuid())
  datasetId           String                          @map("dataset_id")
  dataset             LoyaltyDataset                  @relation(fields: [datasetId], references: [id], onDelete: Restrict)
  externalKey         String                          @map("external_key")
  manualDisplayName   String?                         @map("manual_display_name")
  manualCity          String?                         @map("manual_city")
  manualAttributes    Json?                           @map("manual_attributes")
  archivedAt          DateTime?                       @map("archived_at")
  createdAt           DateTime                        @default(now()) @map("created_at")
  updatedAt           DateTime                        @updatedAt @map("updated_at")
  sourceRecords       LoyaltySourceRecord[]
  links               LoyaltyEntityLink[]
  reconciliationCases LoyaltyReconciliationCase[]
  changes             LoyaltyEntityChange[]
  organizationRoles   LoyaltyPersonOrganizationRole[]
  callAssignments     LoyaltyCallAssignment[]         @relation("LoyaltyAssignmentAnnaPerson")
  tasks               LoyaltyTask[]                   @relation("LoyaltyTaskAnnaPerson")
  engagementEvents    LoyaltyEngagementEvent[]        @relation("LoyaltyEventAnnaPerson")
  manualEntity        LoyaltyManualEntity?            @relation("LoyaltyManualPerson")
  contactOverrides    LoyaltyContactOverride[]        @relation("LoyaltyContactOverridePerson")

  @@unique([datasetId, externalKey])
  @@unique([datasetId, id])
  @@index([datasetId, archivedAt])
  @@map("loyalty_persons")
}

model LoyaltyOrganization {
  id                  String                          @id @default(uuid())
  datasetId           String                          @map("dataset_id")
  dataset             LoyaltyDataset                  @relation(fields: [datasetId], references: [id], onDelete: Restrict)
  externalKey         String                          @map("external_key")
  manualDisplayName   String?                         @map("manual_display_name")
  manualCity          String?                         @map("manual_city")
  manualAttributes    Json?                           @map("manual_attributes")
  archivedAt          DateTime?                       @map("archived_at")
  createdAt           DateTime                        @default(now()) @map("created_at")
  updatedAt           DateTime                        @updatedAt @map("updated_at")
  sourceRecords       LoyaltySourceRecord[]
  links               LoyaltyEntityLink[]
  reconciliationCases LoyaltyReconciliationCase[]
  changes             LoyaltyEntityChange[]
  personRoles         LoyaltyPersonOrganizationRole[]
  callAssignments     LoyaltyCallAssignment[]         @relation("LoyaltyAssignmentAnnaOrganization")
  tasks               LoyaltyTask[]                   @relation("LoyaltyTaskAnnaOrganization")
  engagementEvents    LoyaltyEngagementEvent[]        @relation("LoyaltyEventAnnaOrganization")
  manualEntity        LoyaltyManualEntity?            @relation("LoyaltyManualOrganization")
  contactOverrides    LoyaltyContactOverride[]        @relation("LoyaltyContactOverrideOrganization")
  contactPeople       LoyaltyAgencyContactPerson[]

  @@unique([datasetId, externalKey])
  @@unique([datasetId, id])
  @@index([datasetId, archivedAt])
  @@map("loyalty_organizations")
}

// Immutable source row/version inside a snapshot. personId/organizationId is
// guarded by a SQL CHECK in the migration (exactly one must be populated).
model LoyaltySourceRecord {
  id                 String                          @id @default(uuid())
  snapshotId         String                          @map("snapshot_id")
  snapshot           LoyaltySnapshot                 @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  sourceKey          String                          @map("source_key")
  sourceRowNumber    Int?                            @map("source_row_number")
  entityType         LoyaltyEntityType               @map("entity_type")
  personId           String?                         @map("person_id")
  person             LoyaltyPerson?                  @relation(fields: [personId], references: [id], onDelete: Restrict)
  organizationId     String?                         @map("organization_id")
  organization       LoyaltyOrganization?            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  displayName        String                          @map("display_name")
  city               String?
  taxId              String?                         @map("tax_id")
  sourceSystem       LoyaltyExternalSystem           @default(ANNA_FILE) @map("source_system")
  sourceExternalId   String?                         @map("source_external_id")
  rowFingerprint     String                          @map("row_fingerprint")
  attributes         Json?
  sourceArchivedAt   DateTime?                       @map("source_archived_at")
  createdAt          DateTime                        @default(now()) @map("created_at")
  contactPoints      LoyaltyContactPoint[]
  externalIdentities LoyaltyExternalIdentity[]
  activities         LoyaltyActivity[]
  metrics            LoyaltyMetricSnapshot[]
  sourceAggregate    LoyaltySourceAggregate?
  fieldValues        LoyaltySourceFieldValue[]
  organizationRoles  LoyaltyPersonOrganizationRole[]

  @@unique([snapshotId, sourceKey])
  @@unique([snapshotId, id])
  @@index([snapshotId, entityType, sourceArchivedAt])
  @@index([personId])
  @@index([organizationId])
  @@index([taxId])
  @@map("loyalty_source_records")
}

// Snapshot-scoped person ↔ organization membership. It is evidence, not a
// mutation of the existing BrokerAgency relation.
model LoyaltyPersonOrganizationRole {
  id             String                @id @default(uuid())
  personId       String                @map("person_id")
  person         LoyaltyPerson         @relation(fields: [personId], references: [id], onDelete: Restrict)
  organizationId String                @map("organization_id")
  organization   LoyaltyOrganization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  sourceRecordId String                @map("source_record_id")
  sourceRecord   LoyaltySourceRecord   @relation(fields: [sourceRecordId], references: [id], onDelete: Restrict)
  role           String
  isPrimary      Boolean               @default(false) @map("is_primary")
  validFrom      DateTime              @default(now()) @map("valid_from")
  validTo        DateTime?             @map("valid_to")
  sourceSystem   LoyaltyExternalSystem @default(ANNA_FILE) @map("source_system")
  evidence       Json?
  createdAt      DateTime              @default(now()) @map("created_at")

  @@unique([sourceRecordId, organizationId, role])
  @@index([personId, isPrimary, validTo])
  @@index([organizationId, validTo])
  @@map("loyalty_person_organization_roles")
}

// First-class per-field provenance. rawValue remains immutable; normalized
// values support matching, while valueHash makes repeated observations safe.
model LoyaltySourceFieldValue {
  id               String                @id @default(uuid())
  sourceRecordId   String                @map("source_record_id")
  sourceRecord     LoyaltySourceRecord   @relation(fields: [sourceRecordId], references: [id], onDelete: Restrict)
  fieldName        String                @map("field_name")
  rawValue         Json                  @map("raw_value")
  normalizedValue  String?               @map("normalized_value")
  valueHash        String                @map("value_hash")
  sourceSystem     LoyaltyExternalSystem @map("source_system")
  sourceExternalId String?               @map("source_external_id")
  lockedByUser     Boolean               @default(false) @map("locked_by_user")
  observedAt       DateTime              @default(now()) @map("observed_at")
  createdAt        DateTime              @default(now()) @map("created_at")

  @@unique([sourceRecordId, fieldName, valueHash, sourceSystem])
  @@index([sourceRecordId, fieldName, observedAt])
  @@index([fieldName, normalizedValue])
  @@map("loyalty_source_field_values")
}

model LoyaltyContactPoint {
  id              String                  @id @default(uuid())
  sourceRecordId  String                  @map("source_record_id")
  sourceRecord    LoyaltySourceRecord     @relation(fields: [sourceRecordId], references: [id], onDelete: Restrict)
  type            LoyaltyContactPointType
  value           String
  normalizedValue String                  @map("normalized_value")
  label           String?
  isPrimary       Boolean                 @default(false) @map("is_primary")
  createdAt       DateTime                @default(now()) @map("created_at")

  @@unique([sourceRecordId, type, normalizedValue])
  @@index([type, normalizedValue])
  @@map("loyalty_contact_points")
}

// One source row may retain every observed amoCRM ID; there is no scalar
// amoContactId and therefore no accidental collapse to the first contact.
model LoyaltyExternalIdentity {
  id             String                    @id @default(uuid())
  sourceRecordId String                    @map("source_record_id")
  sourceRecord   LoyaltySourceRecord       @relation(fields: [sourceRecordId], references: [id], onDelete: Restrict)
  system         LoyaltyExternalSystem
  entityType     LoyaltyExternalEntityType @map("entity_type")
  externalId     String                    @map("external_id")
  url            String?
  isPrimary      Boolean                   @default(false) @map("is_primary")
  observedAt     DateTime                  @default(now()) @map("observed_at")
  activities     LoyaltyActivity[]

  @@unique([sourceRecordId, system, entityType, externalId])
  @@index([system, entityType, externalId])
  @@map("loyalty_external_identities")
}

model LoyaltyActivity {
  id                 String                   @id @default(uuid())
  snapshotId         String                   @map("snapshot_id")
  snapshot           LoyaltySnapshot          @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  sourceRecordId     String                   @map("source_record_id")
  sourceRecord       LoyaltySourceRecord      @relation(fields: [sourceRecordId], references: [id], onDelete: Restrict)
  externalIdentityId String?                  @map("external_identity_id")
  externalIdentity   LoyaltyExternalIdentity? @relation(fields: [externalIdentityId], references: [id], onDelete: SetNull)
  sourceSystem       LoyaltyExternalSystem    @map("source_system")
  sourceExternalId   String                   @map("source_external_id")
  type               LoyaltyActivityType
  occurredAt         DateTime                 @map("occurred_at")
  amount             Decimal?                 @db.Decimal(18, 2)
  currency           String                   @default("RUB")
  contractType       String?                  @map("contract_type")
  verdict            LoyaltyActivityVerdict   @default(UNKNOWN)
  reasonCode         String?                  @map("reason_code")
  ruleVersion        String                   @map("rule_version")
  sourcePayloadHash  String?                  @map("source_payload_hash")
  metadata           Json?
  archivedAt         DateTime?                @map("archived_at")
  createdAt          DateTime                 @default(now()) @map("created_at")

  @@unique([snapshotId, sourceSystem, type, sourceExternalId, ruleVersion])
  @@index([sourceRecordId, type, occurredAt])
  @@index([sourceSystem, sourceExternalId])
  @@map("loyalty_activities")
}

model LoyaltyMetricSnapshot {
  id                    String              @id @default(uuid())
  sourceRecordId        String              @map("source_record_id")
  sourceRecord          LoyaltySourceRecord @relation(fields: [sourceRecordId], references: [id], onDelete: Restrict)
  ruleVersion           String              @map("rule_version")
  fixationCount         Int                 @default(0) @map("fixation_count")
  meetingCount          Int                 @default(0) @map("meeting_count")
  dealCount             Int                 @default(0) @map("deal_count")
  brokerTourCount       Int                 @default(0) @map("broker_tour_count")
  callCount             Int                 @default(0) @map("call_count")
  activityEvidenceCount Int                 @default(0) @map("activity_evidence_count")
  dealAmount            Decimal             @default(0) @map("deal_amount") @db.Decimal(18, 2)
  calculatedAt          DateTime            @default(now()) @map("calculated_at")

  @@unique([sourceRecordId, ruleVersion])
  @@index([ruleVersion, calculatedAt])
  @@map("loyalty_metric_snapshots")
}

// A single, snapshot-scoped aggregate statement for an imported source row.
// Nullable measures mean "not reported", which is different from zero. The
// explicit KPI flag makes cross-row totals opt-in and prevents broker/agency
// rollups from being counted twice. Exact event rows always take precedence in
// API reads whenever the active snapshot contains event-level evidence.
model LoyaltySourceAggregate {
  id                         String                     @id @default(uuid())
  sourceRecordId             String                     @unique @map("source_record_id")
  sourceRecord               LoyaltySourceRecord        @relation(fields: [sourceRecordId], references: [id], onDelete: Restrict)
  sourceKind                 String                     @map("source_kind")
  sourceVersion              String                     @map("source_version")
  sourceLabel                String?                    @map("source_label")
  quality                    LoyaltyAggregateQuality
  exactness                  LoyaltyAggregateExactness
  periodKind                 LoyaltyAggregatePeriodKind @default(UNKNOWN) @map("period_kind")
  periodFrom                 DateTime?                  @map("period_from")
  periodTo                   DateTime?                  @map("period_to")
  contributesToSourceSummary Boolean                    @default(false) @map("contributes_to_source_summary")
  fixationCount              Int?                       @map("fixation_count")
  meetingCount               Int?                       @map("meeting_count")
  dealCount                  Int?                       @map("deal_count")
  brokerTourCount            Int?                       @map("broker_tour_count")
  callCount                  Int?                       @map("call_count")
  dealAmount                 Decimal?                   @map("deal_amount") @db.Decimal(18, 2)
  currency                   String?
  lastFixationAt             DateTime?                  @map("last_fixation_at")
  lastMeetingAt              DateTime?                  @map("last_meeting_at")
  lastDealAt                 DateTime?                  @map("last_deal_at")
  lastCallAt                 DateTime?                  @map("last_call_at")
  brokerTourVisited          Boolean?                   @map("broker_tour_visited")
  brokerTourAt               DateTime?                  @map("broker_tour_at")
  dealsByMonth               Json?                      @map("deals_by_month")
  callBreakdown              Json?                      @map("call_breakdown")
  provenance                 Json?
  reportedAt                 DateTime?                  @map("reported_at")
  createdAt                  DateTime                   @default(now()) @map("created_at")

  @@index([quality, contributesToSourceSummary], map: "loyalty_source_aggregates_summary_idx")
  @@index([sourceKind, sourceVersion])
  @@map("loyalty_source_aggregates")
}

// Append-only pointer transition history. Snapshot rows are immutable source
// data, while this relation records every publish/rollback A -> B -> A.
model LoyaltyPublicationEvent {
  id                 String           @id @default(uuid())
  datasetId          String           @map("dataset_id")
  dataset            LoyaltyDataset   @relation(fields: [datasetId], references: [id], onDelete: Restrict)
  snapshotId         String           @map("snapshot_id")
  snapshot           LoyaltySnapshot  @relation("LoyaltyPublicationTarget", fields: [snapshotId], references: [id], onDelete: Restrict)
  previousSnapshotId String?          @map("previous_snapshot_id")
  previousSnapshot   LoyaltySnapshot? @relation("LoyaltyPublicationPrevious", fields: [previousSnapshotId], references: [id], onDelete: Restrict)
  contentHash        String           @map("content_hash")
  ruleVersion        String           @map("rule_version")
  isRollback         Boolean          @default(false) @map("is_rollback")
  actorId            String?          @map("actor_id")
  createdAt          DateTime         @default(now()) @map("created_at")

  @@index([datasetId, createdAt])
  @@index([snapshotId, createdAt])
  @@map("loyalty_publication_events")
}

// A confirmed link is only a reversible association. It never copies or
// merges a LoyaltyPerson/Organization into Broker/Agency.
model LoyaltyEntityLink {
  id                   String                     @id @default(uuid())
  personId             String?                    @map("person_id")
  person               LoyaltyPerson?             @relation(fields: [personId], references: [id], onDelete: Restrict)
  organizationId       String?                    @map("organization_id")
  organization         LoyaltyOrganization?       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  targetType           LoyaltyEntityType          @map("target_type")
  targetId             String                     @map("target_id")
  status               LoyaltyLinkStatus          @default(PROPOSED)
  version              Int                        @default(1)
  reconciliationCaseId String?                    @map("reconciliation_case_id")
  reconciliationCase   LoyaltyReconciliationCase? @relation(fields: [reconciliationCaseId], references: [id], onDelete: SetNull)
  evidence             Json?
  ruleVersion          String                     @map("rule_version")
  createdById          String?                    @map("created_by_id")
  decidedById          String?                    @map("decided_by_id")
  decidedAt            DateTime?                  @map("decided_at")
  revokedById          String?                    @map("revoked_by_id")
  revokedAt            DateTime?                  @map("revoked_at")
  createdAt            DateTime                   @default(now()) @map("created_at")

  @@index([personId, status])
  @@index([organizationId, status])
  @@index([targetType, targetId, status])
  @@map("loyalty_entity_links")
}

model LoyaltyReconciliationCase {
  id              String                         @id @default(uuid())
  datasetId       String                         @map("dataset_id")
  dataset         LoyaltyDataset                 @relation(fields: [datasetId], references: [id], onDelete: Restrict)
  snapshotId      String                         @map("snapshot_id")
  snapshot        LoyaltySnapshot                @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  personId        String?                        @map("person_id")
  person          LoyaltyPerson?                 @relation(fields: [personId], references: [id], onDelete: Restrict)
  organizationId  String?                        @map("organization_id")
  organization    LoyaltyOrganization?           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  targetType      LoyaltyEntityType              @map("target_type")
  targetId        String                         @map("target_id")
  matchCodes      String[]                       @default([]) @map("match_codes")
  evidence        Json?
  score           Decimal                        @default(0) @db.Decimal(5, 4)
  ruleVersion     String                         @map("rule_version")
  status          LoyaltyReconciliationStatus    @default(OPEN)
  decision        LoyaltyReconciliationDecision?
  decisionReason  String?                        @map("decision_reason") @db.Text
  decisionPayload Json?                          @map("decision_payload")
  version         Int                            @default(1)
  resolvedById    String?                        @map("resolved_by_id")
  resolvedAt      DateTime?                      @map("resolved_at")
  createdAt       DateTime                       @default(now()) @map("created_at")
  updatedAt       DateTime                       @updatedAt @map("updated_at")
  links           LoyaltyEntityLink[]

  @@index([snapshotId, status, targetType])
  @@index([personId, status])
  @@index([organizationId, status])
  @@index([targetType, targetId])
  @@map("loyalty_reconciliation_cases")
}

// Manual override audit keeps the before/after values needed for review and
// rollback. Access is restricted to the same ADMIN-only bounded context.
model LoyaltyEntityChange {
  id             String               @id @default(uuid())
  personId       String?              @map("person_id")
  person         LoyaltyPerson?       @relation(fields: [personId], references: [id], onDelete: Restrict)
  organizationId String?              @map("organization_id")
  organization   LoyaltyOrganization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  action         LoyaltyChangeAction
  changedFields  String[]             @default([]) @map("changed_fields")
  beforeValues   Json?                @map("before_values")
  afterValues    Json?                @map("after_values")
  actorId        String?              @map("actor_id")
  createdAt      DateTime             @default(now()) @map("created_at")

  @@index([personId, createdAt])
  @@index([organizationId, createdAt])
  @@map("loyalty_entity_changes")
}

// ─── CMS / LANDING CONTENT ───────────────────────────

// Generic key-value content for landing blocks (hero, advantages, commission, contact, etc.)
/// Server-side call campaign. The immutable filter snapshot and hash make
/// "select all by filter" reproducible without sending thousands of IDs.
model LoyaltyCallCampaign {
  id             String                  @id @default(uuid())
  name           String                  @db.VarChar(160)
  message        String                  @db.Text
  base           LoyaltyBaseKind
  entityType     LoyaltyEntityType       @map("entity_type")
  snapshotId     String?                 @map("snapshot_id")
  snapshot       LoyaltySnapshot?        @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  filterSnapshot Json                    @map("filter_snapshot")
  filterHash     String                  @map("filter_hash") @db.VarChar(64)
  expectedCount  Int                     @map("expected_count")
  status         LoyaltyCampaignStatus   @default(DRAFT)
  version        Int                     @default(1)
  createdById    String                  @map("created_by_id")
  createdBy      Broker                  @relation("LoyaltyCampaignCreator", fields: [createdById], references: [id], onDelete: Restrict)
  startedAt      DateTime?               @map("started_at")
  completedAt    DateTime?               @map("completed_at")
  archivedAt     DateTime?               @map("archived_at")
  createdAt      DateTime                @default(now()) @map("created_at")
  updatedAt      DateTime                @updatedAt @map("updated_at")
  assignments    LoyaltyCallAssignment[]

  @@index([status, createdAt])
  @@index([createdById, status])
  @@index([snapshotId])
  @@map("loyalty_call_campaigns")
}

/// One immutable campaign target. Exactly one target FK is set (DB CHECK).
model LoyaltyCallAssignment {
  id                 String                  @id @default(uuid())
  campaignId         String                  @map("campaign_id")
  campaign           LoyaltyCallCampaign     @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  annaPersonId       String?                 @map("anna_person_id")
  annaPerson         LoyaltyPerson?          @relation("LoyaltyAssignmentAnnaPerson", fields: [annaPersonId], references: [id], onDelete: Restrict)
  annaOrganizationId String?                 @map("anna_organization_id")
  annaOrganization   LoyaltyOrganization?    @relation("LoyaltyAssignmentAnnaOrganization", fields: [annaOrganizationId], references: [id], onDelete: Restrict)
  ourBrokerId        String?                 @map("our_broker_id")
  ourBroker          Broker?                 @relation("LoyaltyAssignmentOurBroker", fields: [ourBrokerId], references: [id], onDelete: Restrict)
  ourAgencyId        String?                 @map("our_agency_id")
  ourAgency          Agency?                 @relation("LoyaltyAssignmentOurAgency", fields: [ourAgencyId], references: [id], onDelete: Restrict)
  assignedToId       String                  @map("assigned_to_id")
  assignedTo         Broker                  @relation("LoyaltyAssignmentAssignee", fields: [assignedToId], references: [id], onDelete: Restrict)
  assignedById       String                  @map("assigned_by_id")
  assignedBy         Broker                  @relation("LoyaltyAssignmentAssigner", fields: [assignedById], references: [id], onDelete: Restrict)
  status             LoyaltyAssignmentStatus @default(PENDING)
  version            Int                     @default(1)
  assignedAt         DateTime                @default(now()) @map("assigned_at")
  startedAt          DateTime?               @map("started_at")
  completedAt        DateTime?               @map("completed_at")
  cancelledAt        DateTime?               @map("cancelled_at")
  attempts           LoyaltyCallAttempt[]
  tasks              LoyaltyTask[]

  @@index([campaignId, status])
  @@index([assignedToId, status, assignedAt])
  @@index([annaPersonId])
  @@index([annaOrganizationId])
  @@index([ourBrokerId])
  @@index([ourAgencyId])
  @@map("loyalty_call_assignments")
}

/// Append-only call result. A correction is another row linked to the row it
/// corrects; submissionId provides retry-safe operator saves.
model LoyaltyCallAttempt {
  id                String                @id @default(uuid())
  assignmentId      String                @map("assignment_id")
  assignment        LoyaltyCallAssignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  submissionId      String                @unique @map("submission_id") @db.VarChar(80)
  operatorId        String                @map("operator_id")
  operator          Broker                @relation("LoyaltyCallAttemptOperator", fields: [operatorId], references: [id], onDelete: Restrict)
  result            LoyaltyCallResult
  comment           String?               @db.Text
  nextStep          String?               @map("next_step") @db.Text
  nextActionAt      DateTime?             @map("next_action_at")
  source            String                @default("LOYALTY_CALL_QUEUE") @db.VarChar(64)
  correctsAttemptId String?               @map("corrects_attempt_id")
  correctsAttempt   LoyaltyCallAttempt?   @relation("LoyaltyCallAttemptCorrections", fields: [correctsAttemptId], references: [id], onDelete: Restrict)
  corrections       LoyaltyCallAttempt[]  @relation("LoyaltyCallAttemptCorrections")
  correctionReason  String?               @map("correction_reason") @db.Text
  occurredAt        DateTime              @default(now()) @map("occurred_at")
  createdAt         DateTime              @default(now()) @map("created_at")
  tasks             LoyaltyTask[]

  @@index([assignmentId, occurredAt])
  @@index([operatorId, occurredAt])
  @@index([correctsAttemptId])
  @@map("loyalty_call_attempts")
}

model LoyaltyTask {
  id                 String                 @id @default(uuid())
  annaPersonId       String?                @map("anna_person_id")
  annaPerson         LoyaltyPerson?         @relation("LoyaltyTaskAnnaPerson", fields: [annaPersonId], references: [id], onDelete: Restrict)
  annaOrganizationId String?                @map("anna_organization_id")
  annaOrganization   LoyaltyOrganization?   @relation("LoyaltyTaskAnnaOrganization", fields: [annaOrganizationId], references: [id], onDelete: Restrict)
  ourBrokerId        String?                @map("our_broker_id")
  ourBroker          Broker?                @relation("LoyaltyTaskOurBroker", fields: [ourBrokerId], references: [id], onDelete: Restrict)
  ourAgencyId        String?                @map("our_agency_id")
  ourAgency          Agency?                @relation("LoyaltyTaskOurAgency", fields: [ourAgencyId], references: [id], onDelete: Restrict)
  assignmentId       String?                @map("assignment_id")
  assignment         LoyaltyCallAssignment? @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  callAttemptId      String?                @map("call_attempt_id")
  callAttempt        LoyaltyCallAttempt?    @relation(fields: [callAttemptId], references: [id], onDelete: Restrict)
  title              String                 @db.VarChar(240)
  description        String?                @db.Text
  status             LoyaltyTaskStatus      @default(OPEN)
  dueAt              DateTime?              @map("due_at")
  assignedToId       String                 @map("assigned_to_id")
  assignedTo         Broker                 @relation("LoyaltyTaskAssignee", fields: [assignedToId], references: [id], onDelete: Restrict)
  createdById        String                 @map("created_by_id")
  createdBy          Broker                 @relation("LoyaltyTaskCreator", fields: [createdById], references: [id], onDelete: Restrict)
  version            Int                    @default(1)
  completedAt        DateTime?              @map("completed_at")
  cancelledAt        DateTime?              @map("cancelled_at")
  createdAt          DateTime               @default(now()) @map("created_at")
  updatedAt          DateTime               @updatedAt @map("updated_at")

  @@index([assignedToId, status, dueAt])
  @@index([annaPersonId, status])
  @@index([annaOrganizationId, status])
  @@index([ourBrokerId, status])
  @@index([ourAgencyId, status])
  @@index([assignmentId])
  @@index([callAttemptId])
  @@map("loyalty_tasks")
}

/// Loyalty benefit/history event. Rows are immutable; correction uses a new
/// event linked by correctsEventId.
model LoyaltyEngagementEvent {
  id                 String                   @id @default(uuid())
  annaPersonId       String?                  @map("anna_person_id")
  annaPerson         LoyaltyPerson?           @relation("LoyaltyEventAnnaPerson", fields: [annaPersonId], references: [id], onDelete: Restrict)
  annaOrganizationId String?                  @map("anna_organization_id")
  annaOrganization   LoyaltyOrganization?     @relation("LoyaltyEventAnnaOrganization", fields: [annaOrganizationId], references: [id], onDelete: Restrict)
  ourBrokerId        String?                  @map("our_broker_id")
  ourBroker          Broker?                  @relation("LoyaltyEventOurBroker", fields: [ourBrokerId], references: [id], onDelete: Restrict)
  ourAgencyId        String?                  @map("our_agency_id")
  ourAgency          Agency?                  @relation("LoyaltyEventOurAgency", fields: [ourAgencyId], references: [id], onDelete: Restrict)
  type               LoyaltyEngagementType
  occurredAt         DateTime                 @map("occurred_at")
  comment            String?                  @db.Text
  amount             Decimal?                 @db.Decimal(18, 2)
  value              String?                  @db.VarChar(500)
  validUntil         DateTime?                @map("valid_until")
  attachmentUrl      String?                  @map("attachment_url") @db.VarChar(1000)
  basisUrl           String?                  @map("basis_url") @db.VarChar(1000)
  createdById        String                   @map("created_by_id")
  createdBy          Broker                   @relation("LoyaltyEventCreator", fields: [createdById], references: [id], onDelete: Restrict)
  correctsEventId    String?                  @map("corrects_event_id")
  correctsEvent      LoyaltyEngagementEvent?  @relation("LoyaltyEventCorrections", fields: [correctsEventId], references: [id], onDelete: Restrict)
  corrections        LoyaltyEngagementEvent[] @relation("LoyaltyEventCorrections")
  attachments        LoyaltyEventAttachment[]
  correctionReason   String?                  @map("correction_reason") @db.Text
  archivedAt         DateTime?                @map("archived_at")
  version            Int                      @default(1)
  createdAt          DateTime                 @default(now()) @map("created_at")

  @@index([annaPersonId, occurredAt])
  @@index([annaOrganizationId, occurredAt])
  @@index([ourBrokerId, occurredAt])
  @@index([ourAgencyId, occurredAt])
  @@index([type, occurredAt])
  @@index([correctsEventId])
  @@map("loyalty_engagement_events")
}

/// Protected binary evidence for a loyalty event. Bytes remain in PostgreSQL,
/// so nginx never exposes the file without current API authorization.
model LoyaltyEventAttachment {
  id          String                 @id @default(uuid())
  eventId     String                 @map("event_id")
  event       LoyaltyEngagementEvent @relation(fields: [eventId], references: [id], onDelete: Restrict)
  fileName    String                 @map("file_name") @db.VarChar(240)
  mimeType    String                 @map("mime_type") @db.VarChar(120)
  size        Int
  sha256      String                 @db.Char(64)
  data        Bytes
  version     Int                    @default(1)
  createdById String                 @map("created_by_id")
  createdBy   Broker                 @relation("LoyaltyEventAttachmentCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime               @default(now()) @map("created_at")
  archivedAt  DateTime?              @map("archived_at")

  @@index([eventId, archivedAt, createdAt])
  @@index([createdById, createdAt])
  @@map("loyalty_event_attachments")
}

model LoyaltySavedView {
  id         String            @id @default(uuid())
  ownerId    String            @map("owner_id")
  owner      Broker            @relation("LoyaltySavedViewOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  name       String            @db.VarChar(160)
  base       LoyaltyBaseKind
  entityType LoyaltyEntityType @map("entity_type")
  filters    Json
  filterHash String            @map("filter_hash") @db.VarChar(64)
  isShared   Boolean           @default(false) @map("is_shared")
  createdAt  DateTime          @default(now()) @map("created_at")
  updatedAt  DateTime          @updatedAt @map("updated_at")

  @@unique([ownerId, name, base, entityType])
  @@index([base, entityType, isShared])
  @@map("loyalty_saved_views")
}

model LoyaltyWorkflowAudit {
  id         String   @id @default(uuid())
  actorId    String   @map("actor_id")
  actor      Broker   @relation("LoyaltyWorkflowAuditActor", fields: [actorId], references: [id], onDelete: Restrict)
  action     String   @db.VarChar(100)
  entityType String   @map("entity_type") @db.VarChar(100)
  entityId   String   @map("entity_id") @db.VarChar(100)
  before     Json?
  after      Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@map("loyalty_workflow_audits")
}

model LoyaltyUserGrant {
  id          String            @id @default(uuid())
  userId      String            @map("user_id")
  user        Broker            @relation("LoyaltyGrantUser", fields: [userId], references: [id], onDelete: Cascade)
  permission  LoyaltyPermission
  grantedById String            @map("granted_by_id")
  grantedBy   Broker            @relation("LoyaltyGrantIssuer", fields: [grantedById], references: [id], onDelete: Restrict)
  grantedAt   DateTime          @default(now()) @map("granted_at")
  revokedAt   DateTime?         @map("revoked_at")

  @@index([userId, permission, revokedAt])
  @@index([grantedById, grantedAt])
  @@map("loyalty_user_grants")
}

model LoyaltyExportJob {
  id          String              @id @default(uuid())
  createdById String              @map("created_by_id")
  createdBy   Broker              @relation("LoyaltyExportCreator", fields: [createdById], references: [id], onDelete: Restrict)
  base        LoyaltyBaseKind
  entityType  LoyaltyEntityType   @map("entity_type")
  filterHash  String              @map("filter_hash") @db.VarChar(64)
  filter      Json
  status      LoyaltyExportStatus @default(PENDING)
  rowCount    Int?                @map("row_count")
  storageKey  String?             @map("storage_key") @db.VarChar(500)
  failureCode String?             @map("failure_code") @db.VarChar(100)
  expiresAt   DateTime?           @map("expires_at")
  createdAt   DateTime            @default(now()) @map("created_at")
  completedAt DateTime?           @map("completed_at")

  @@index([createdById, createdAt])
  @@index([status, expiresAt])
  @@map("loyalty_export_jobs")
}

/// PII-free audit record for a bounded, read-only source scan. The raw source
/// payload is never persisted; only counts, a content hash and safe error code
/// are retained so operators can prove whether a complete dry-run occurred.
model LoyaltySyncRun {
  id            String            @id @default(uuid())
  source        LoyaltySyncSource
  status        LoyaltySyncStatus @default(RUNNING)
  ruleVersion   String            @map("rule_version") @db.VarChar(100)
  sourceRefHash String?           @map("source_ref_hash") @db.VarChar(64)
  contentHash   String?           @map("content_hash") @db.VarChar(64)
  counts        Json?
  errorCode     String?           @map("error_code") @db.VarChar(100)
  requestedById String            @map("requested_by_id")
  requestedBy   Broker            @relation("LoyaltySyncRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  startedAt     DateTime          @default(now()) @map("started_at")
  completedAt   DateTime?         @map("completed_at")

  @@index([source, startedAt])
  @@index([status, startedAt])
  @@index([requestedById, startedAt])
  @@map("loyalty_sync_runs")
}

/// Manual ANNA entity overlay. It is deliberately outside immutable imported
/// snapshots: creating a contact cannot change a published content hash or
/// declared coverage. Read projections union active overlays with the active
/// snapshot and apply the same filters/export rules.
model LoyaltyManualEntity {
  id              String               @id @default(uuid())
  datasetId       String               @map("dataset_id")
  dataset         LoyaltyDataset       @relation(fields: [datasetId], references: [id], onDelete: Restrict)
  entityType      LoyaltyEntityType    @map("entity_type")
  personId        String?              @unique @map("person_id")
  person          LoyaltyPerson?       @relation("LoyaltyManualPerson", fields: [personId], references: [id], onDelete: Restrict)
  organizationId  String?              @unique @map("organization_id")
  organization    LoyaltyOrganization? @relation("LoyaltyManualOrganization", fields: [organizationId], references: [id], onDelete: Restrict)
  displayName     String               @map("display_name") @db.VarChar(300)
  city            String?              @db.VarChar(200)
  phoneNormalized String?              @map("phone_normalized") @db.VarChar(32)
  emailNormalized String?              @map("email_normalized") @db.VarChar(254)
  contactPoints   Json                 @map("contact_points")
  attributes      Json?
  createdById     String               @map("created_by_id")
  createdBy       Broker               @relation("LoyaltyManualCreator", fields: [createdById], references: [id], onDelete: Restrict)
  version         Int                  @default(1)
  archivedAt      DateTime?            @map("archived_at")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  @@unique([datasetId, phoneNormalized])
  @@unique([datasetId, emailNormalized])
  @@index([datasetId, entityType, archivedAt])
  @@index([createdById, createdAt])
  @@map("loyalty_manual_entities")
}

/// Typed manual contact correction/addition for ANNA entities. Source contact
/// rows and existing manual overlay JSON remain untouched; this additive table
/// provides optimistic edits and soft archive without rewriting a snapshot.
model LoyaltyContactOverride {
  id              String                  @id @default(uuid())
  datasetId       String                  @map("dataset_id")
  dataset         LoyaltyDataset          @relation(fields: [datasetId], references: [id], onDelete: Restrict)
  entityType      LoyaltyEntityType       @map("entity_type")
  personId        String?                 @map("person_id")
  person          LoyaltyPerson?          @relation("LoyaltyContactOverridePerson", fields: [personId], references: [id], onDelete: Restrict)
  organizationId  String?                 @map("organization_id")
  organization    LoyaltyOrganization?    @relation("LoyaltyContactOverrideOrganization", fields: [organizationId], references: [id], onDelete: Restrict)
  type            LoyaltyContactPointType
  value           String
  normalizedValue String                  @map("normalized_value")
  label           String?                 @db.VarChar(160)
  isPrimary       Boolean                 @default(false) @map("is_primary")
  createdById     String                  @map("created_by_id")
  createdBy       Broker                  @relation("LoyaltyContactOverrideCreator", fields: [createdById], references: [id], onDelete: Restrict)
  version         Int                     @default(1)
  archivedAt      DateTime?               @map("archived_at")
  createdAt       DateTime                @default(now()) @map("created_at")
  updatedAt       DateTime                @updatedAt @map("updated_at")

  @@index([datasetId, entityType, archivedAt])
  @@index([personId, archivedAt])
  @@index([organizationId, archivedAt])
  @@index([type, normalizedValue, archivedAt])
  @@index([createdById, createdAt])
  @@map("loyalty_contact_overrides")
}

/// Contact people belonging to an ANNA agency are not automatically brokers.
/// Manual corrections live outside the immutable source snapshot and use a
/// typed JSON contact array so one person can retain every communication path.
model LoyaltyAgencyContactPerson {
  id              String              @id @default(uuid())
  datasetId       String              @map("dataset_id")
  dataset         LoyaltyDataset      @relation(fields: [datasetId], references: [id], onDelete: Restrict)
  organizationId  String              @map("organization_id")
  organization    LoyaltyOrganization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  displayName     String              @map("display_name") @db.VarChar(300)
  role            String?             @db.VarChar(160)
  actualityStatus String              @default("CURRENT") @map("actuality_status") @db.VarChar(24)
  contactPoints   Json                @map("contact_points")
  createdById     String              @map("created_by_id")
  createdBy       Broker              @relation("LoyaltyAgencyContactPersonCreator", fields: [createdById], references: [id], onDelete: Restrict)
  version         Int                 @default(1)
  archivedAt      DateTime?           @map("archived_at")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  @@index([datasetId, organizationId, archivedAt])
  @@index([createdById, createdAt])
  @@map("loyalty_agency_contact_people")
}

model SiteContent {
  key       String   @id // e.g. "hero", "advantages", "commission", "contact"
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")

  @@map("site_content")
}

// 2026-06-04: KV-таблица для админ-настроек, которые администратор хочет
// менять из UI без релиза/SSH. Например MOREKIT_WEBHOOK_URL — Анна из
// Morekit'а периодически даёт новый URL («копия предыдущего процесса»).
// Читается с env-fallback: если в БД нет ключа — берём process.env[KEY].
// 2026-09-08: входящие ops-бота техподдержки (ответы владельца/Анны, файлы с
// решениями) для рабочей сессии ассистента. Заполняется OpsInboxService.
model OpsInboxMessage {
  id           String    @id @default(uuid())
  updateId     BigInt    @unique @map("update_id")
  chatId       String    @map("chat_id")
  chatTitle    String?   @map("chat_title")
  fromName     String?   @map("from_name")
  fromUsername String?   @map("from_username")
  messageId    BigInt    @map("message_id")
  text         String?   @db.Text
  fileId       String?   @map("file_id")
  fileName     String?   @map("file_name")
  fileSize     Int?      @map("file_size")
  mimeType     String?   @map("mime_type")
  replyToText  String?   @map("reply_to_text") @db.Text
  sentAt       DateTime  @map("sent_at")
  handledAt    DateTime? @map("handled_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("ops_inbox_messages")
}

model SystemSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")

  @@map("system_settings")
}

// КБ6 #45 (2026-05-25): история правок CMS-блоков. На каждое изменение
// SiteContent сохраняем снимок предыдущего значения, кто и когда правил.
// Позволяет откатиться / посмотреть изменения «как в Google Docs».
model SiteContentRevision {
  id         String   @id @default(uuid())
  key        String // тот же что в SiteContent
  value      Json // снимок значения после правки
  editorId   String?  @map("editor_id") // brokerId редактора (если есть)
  editorName String?  @map("editor_name") // ФИО на момент правки (для истории)
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([key, createdAt])
  @@map("site_content_revisions")
}

model LandingEvent {
  id          String   @id @default(uuid())
