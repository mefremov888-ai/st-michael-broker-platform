// Политика начисления комиссии для проекта в определённый период.
// Админ может создавать несколько политик; для каждой сделки активной считается
// та, у которой startDate ≤ deal.signedAt (или deal.createdAt) ≤ endDate.
// Перекрытие диапазонов для одного project запрещено на уровне API-валидации.
//
// Пример (правка 2026-05-13):
//   Зорге 9: PROGRESSIVE 01.01.2026—06.05.2026 (старая шкала)
//   Зорге 9: FLAT 4% 07.05.2026—31.12.2099 (новая, действует сейчас)
model CommissionPolicy {
  id                        String         @id @default(uuid())
  project                   Project
  mode                      CommissionMode
  // Условия оплаты являются частью той же политики, что и базовая ставка.
  // Nullable оставлены только для бесшовной миграции старых записей: пока
  // политика не пересохранена, API подхватит legacy-значения из CMS.
  installmentEnabled        Boolean?       @map("installment_enabled")
  installmentDiscount       Decimal?       @map("installment_discount") @db.Decimal(5, 2)
  subsidizedMortgageEnabled Boolean?       @map("subsidized_mortgage_enabled")
  subsidizedMortgageRate    Decimal?       @map("subsidized_mortgage_rate") @db.Decimal(5, 2)
  // Публичное пояснение рядом со ставкой на лендинге/в кабинете.
  displayNote               String?        @map("display_note")
  // Для FLAT — единая ставка (например 4.00).
  flatRate                  Decimal?       @map("flat_rate") @db.Decimal(5, 2)
  // Для PROGRESSIVE — JSON со шкалой: [{level: 'START', minSqm: 0, rate: 5.0}, ...]
  levels                    Json?
  startDate                 DateTime       @map("start_date")
  endDate                   DateTime       @map("end_date")
  isActive                  Boolean        @default(true) @map("is_active")
  notes                     String?
  createdAt                 DateTime       @default(now()) @map("created_at")
  updatedAt                 DateTime       @updatedAt @map("updated_at")

  @@index([project, startDate, endDate])
  @@map("commission_policies")
}

// 2026-09-04: «Реестр сделок» — сквозная аналитика ДДУ. Сшивка трёх источников:
// Google-реестр продаж (source=REGISTRY), amoCRM (source=AMO_ONLY) и их
// пересечение (source=BOTH). Заливается скриптом scripts/upload-registry-deals.js
// (upsert по rowKey, ничего не удаляет). Не участвует в бизнес-логике кабинета —
// только чтение через /admin/registry-deals/*.
model RegistryDeal {
  id                 String    @id @default(uuid())
  // canonicalKey строки реестра либо amo:<leadId> для сделок, найденных только в amo
  rowKey             String    @unique @map("row_key")
  source             String // REGISTRY | BOTH | AMO_ONLY
  contractNumber     String    @map("contract_number")
  project            Project?
  signedAt           DateTime? @map("signed_at") @db.Date
  amount             Decimal?  @db.Decimal(14, 2)
  agencyNameRaw      String?   @map("agency_name_raw")
  agencyCanonical    String?   @map("agency_canonical")
  amoLeadId          BigInt?   @map("amo_lead_id")
  brokerId           String?   @map("broker_id")
  broker             Broker?   @relation(fields: [brokerId], references: [id])
  brokerAmoContactId BigInt?   @map("broker_amo_contact_id")
  // 2026-09-07: объект сделки для карточек «Нашей базы» (площадь, этаж,
  // корпус, квартира). В исходном реестре этих полей нет — заполняются из
  // полей лида amoCRM (scripts/enrich-registry-deals-from-amo.js);
  // object_source = 'amo' | null. Все колонки nullable, без DEFAULT.
  sqm                Decimal?  @db.Decimal(10, 2)
  floor              Int?
  building           String?
  apartmentNumber    String?   @map("apartment_number")
  objectSource       String?   @map("object_source")
  // 2026-09-07 (правила владельца): дата сделки = «Дата оплаты ДДУ» (столбец H
  // реестра, при рассрочке — первая оплата); «платная бронь» = ДВОУ: дата (D),
  // дата оплаты (E), сумма (AA). amount по-прежнему = «Стоимость по ДДУ» (AB).
  paidAt             DateTime? @map("paid_at") @db.Date
  dvouDate           DateTime? @map("dvou_date") @db.Date
  dvouPaidAt         DateTime? @map("dvou_paid_at") @db.Date
  dvouAmount         Decimal?  @map("dvou_amount") @db.Decimal(14, 2)
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@index([agencyCanonical])
  @@index([brokerId])
  @@index([project, signedAt])
  @@index([paidAt])
  @@index([dvouPaidAt])
  @@map("registry_deals")
}
