# === Database ===
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/broker_platform
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# === Auth ===
JWT_SECRET=change-me-in-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
SMS_PROVIDER_API_KEY=

# === Telegram Bot ===
TELEGRAM_BOT_TOKEN=
# Отдельный send-only бот и закрытый чат для технических алертов.
# OPS_TELEGRAM_BOT_TOKEN можно оставить пустым — тогда используется
# TELEGRAM_BOT_TOKEN. Для нескольких чатов укажите ID через запятую.
OPS_TELEGRAM_BOT_TOKEN=
OPS_ALERT_CHAT_ID=
OPS_ALERT_CHAT_IDS=
# Необязательно: таймаут Telegram и cooldown одинаковых app-level алертов.
OPS_TELEGRAM_TIMEOUT_MS=10000
OPS_ALERT_DEDUP_COOLDOWN_MS=300000
API_URL=http://localhost:4000

# === amoCRM ===
AMO_SUBDOMAIN=stmichael
AMO_CLIENT_ID=
AMO_CLIENT_SECRET=
AMO_REDIRECT_URI=
AMO_ACCESS_TOKEN=
AMO_REFRESH_TOKEN=
# ID типа задачи «Аларм» в amoCRM (узнать через workflow Inspect amoCRM fields → entity: task_types).
# Дефолт = 2393839 (Alarm в stmichael.amocrm.ru, цвет E00000). Переопредели если другой аккаунт.
AMO_ALARM_TASK_TYPE_ID=2393839

# === Telephony ===
MANGO_API_KEY=
MANGO_API_SALT=
# Опциональный базовый URL — по умолчанию VPBX (https://app.mango-office.ru/vpbx).
# Если у вас Контакт-центр — переопредели.
MANGO_API_URL=
# Legacy integration-webhook URL template. It may contain credential-like
# query parameters; store it only in a secret manager/SystemSetting.
MANGO_CALLBACK_URL=
# Опциональный outbound caller ID (что увидит клиент при callback).
# Если не задано — Mango возьмёт дефолтную линию аккаунта.
MANGO_OUTBOUND_LINE=
CALLTOUCH_TOKEN=
CALLTOUCH_SITE_ID=

# === Profitbase ===
PROFITBASE_API_KEY=
PROFITBASE_BASE_URL=

# === Morekit ===
# Прямой webhook: после createFixationRequest наш API сам шлёт payload
# в Morekit (раньше это делал Salesbot внутри amoCRM). URL даёт Анна
# из Morekit'а — он периодически меняется («копия предыдущего процесса»).
# Если пусто — notify пропускается с warning в логах, фиксация работает.
MOREKIT_WEBHOOK_URL=

# === Messaging ===
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# === Yandex Disk (auto-sync materials) ===
# Публичная ссылка на папку с материалами для брокеров. Cron в scheduler
# каждые 12 часов запускает scripts/sync-yandex-disk.js — обновляет
# Document записи (category=materials) на лендинге.
YANDEX_DISK_PUBLIC_KEY=https://disk.yandex.ru/d/xgzI7yrg50iYNg

# === Web Push (VAPID) ===
# Generate once: cd apps/api && npx web-push generate-vapid-keys
# Or run: node scripts/generate-vapid.js
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:broker@stmichael.ru

# === Storage ===
S3_ENDPOINT=https://storage.yandexcloud.net
S3_BUCKET=st-michael-media
S3_ACCESS_KEY=
S3_SECRET_KEY=

# === AI (будущий этап) ===
LLM_API_KEY=
LLM_MODEL=

# === App ===
API_PORT=4000
WEB_URL=http://72.56.241.199:3000
API_URL=http://localhost:4000
